# Broker admin token. Copy to .env.admin (chmod 600), or let `pnpm dev` create it.
# Loaded by the broker, API and CLI only. Worker and scheduler refuse to start if it is in their environment.

IX_BROKER_ADMIN_TOKEN=     # generate with: openssl rand -hex 24
# IX_BROKER_ADMIN_SOCKET=/tmp/ix-broker-admin.sock
