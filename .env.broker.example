# Broker-only settings. Copy to .env.broker (chmod 600). Loaded only by the broker process and by migrate.
# Worker, API and scheduler refuse to start if any of these are in their environment.

IX_MASTER_KEY=            # 32 bytes base64, generate with: openssl rand -base64 32
DATABASE_URL_BROKER=postgres://ix_broker:CHANGE_ME@localhost:5432/integratex
DATABASE_URL_ADMIN=postgres://postgres:CHANGE_ME@localhost:5432/integratex   # migrations only
# IX_ALLOW_ENV_SECRETS=1  # dev/mock only: also read IX_SECRET_<REF> from the broker's environment
