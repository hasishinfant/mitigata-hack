# App settings for api / scheduler / worker / CLI. Copy to .env.
# No secrets that could reach a provider go here; provider secrets go in via: ix secret set <ref>
# Broker-only settings (master key, broker/admin DB URLs) go in .env.broker, see .env.broker.example.

DATABASE_URL_APP=postgres://ix_app:CHANGE_ME@localhost:5432/integratex
IX_BROKER_SOCKET=/tmp/ix-broker.sock
IX_ADMIN_TOKEN=           # generate with: openssl rand -hex 16 (needed for dashboard "Run now" and API writes)
IX_API_PORT=7070
OKTA_ORG=                 # e.g. integrator-1234567
GITHUB_ORG=
GITHUB_REPO=              # repo for the issues stream
GITHUB_REPO_OWNER=        # user or org that owns GITHUB_REPO (can differ from GITHUB_ORG)
