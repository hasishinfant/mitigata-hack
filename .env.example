# Copy to .env. No real secret values ever go in this file.
# Provider secrets (GitHub PAT, NVD key, Okta keys, Slack webhook) go in via: ix secret set <ref>

DATABASE_URL_ADMIN=postgres://postgres:postgres@localhost:5432/integratex   # migrations only
DATABASE_URL_APP=postgres://ix_app:ix_app@localhost:5432/integratex
DATABASE_URL_BROKER=postgres://ix_broker:ix_broker@localhost:5432/integratex
IX_MASTER_KEY=            # 32 bytes base64, generate with: openssl rand -base64 32
IX_BROKER_SOCKET=/tmp/ix-broker.sock
IX_ADMIN_TOKEN=
OKTA_ORG=                 # e.g. integrator-1234567
GITHUB_ORG=
GITHUB_REPO=              # repo inside GITHUB_ORG for the issues stream
