{
  "name": "integratex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "ix": "tsx src/cli/ix.ts",
    "migrate": "tsx src/store/migrate.ts",
    "db:up": "docker compose up -d postgres",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:no-provider-code": "! grep -riE 'github|okta|nvd|cisa' src/engine src/broker",
    "dev": "tsx src/dev.ts",
    "dev:mock": "tsx src/dev.ts --mock",
    "api": "tsx src/api/index.ts",
    "scheduler": "tsx src/scheduler/index.ts",
    "worker": "tsx src/worker/index.ts",
    "mock": "tsx mock/server.ts",
    "broker": "tsx src/broker/index.ts",
    "leakcheck": "tsx src/security/leakcheck.ts"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "fastify": "^5.12.7",
    "jose": "^6.2.14",
    "pg": "^8.13.1",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "undici": "^8.12.3",
    "yaml": "^2.7.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.0.0"
  }
}
